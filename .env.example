# LLM provider: codex_cli, gemini, or openai_compatible
ARS_LLM_PROVIDER=codex_cli

# Local Codex CLI (default). Run `codex login` once before starting the app.
# CODEX_MODEL=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: Gemini-compatible gateway endpoint. Keep the official endpoint by default.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# OpenAI-compatible providers (used when ARS_LLM_PROVIDER=openai_compatible)
ARS_LLM_API_KEY=
ARS_LLM_MODEL=gpt-4o-mini
ARS_LLM_BASE_URL=https://api.openai.com/v1

# Optional polite-pool/API settings for literature search
ARS_PUBMED_EMAIL=
ARS_CROSSREF_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
